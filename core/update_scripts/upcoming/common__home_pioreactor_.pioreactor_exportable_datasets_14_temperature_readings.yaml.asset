dataset_name: temperature_readings
default_order_by: timestamp
has_experiment: true
has_unit: true
source: app
table: temperature_readings
timestamp_columns:
- timestamp
description: This dataset includes a time series of temperature readings from the Pioreactors. This data matches what's presented in the "Temperature of vials" chart in the Experiment Overview.
display_name: Temperature readings
column_descriptions:
  experiment: Experiment name.
  pioreactor_unit: Pioreactor unit name.
  timestamp: UTC timestamp from the published temperature reading.
  timestamp_localtime: Local-time rendering of timestamp.
  hours_since_experiment_created: Hours from experiment creation to timestamp.
  temperature_c: Inferred vial temperature.
column_units:
  hours_since_experiment_created: h
  temperature_c: degC
