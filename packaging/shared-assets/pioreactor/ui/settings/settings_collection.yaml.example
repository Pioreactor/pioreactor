---
display_name: Name
key: stable_settings_collection_key
display: true  # true to display in Control / Parameters
source: your_plugin_name
description: This description is displayed with the collection in Control / Parameters.
published_settings:
  - key: setting_key
    unit: mL
    label: Parameter label
    description: This description is displayed with an editable field in Control / Parameters.
    type: numeric  # one of numeric, boolean, string, json
    display: true # true to display on the Pioreactor card
    editable: true # false to prevent quick editing from the Pioreactor card
