{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "homepage": "/static",
  "proxy": "http://localhost:4999",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^4.4.5",
    "@mui/icons-material": "9.1.1",
    "@mui/lab": "9.0.0-beta.5",
    "@mui/material": "9.1.2",
    "@mui/system": "9.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "boring-avatars": "^1.11.2",
    "dayjs": "^1.11.20",
    "js-yaml": "^4.1.1",
    "material-ui-confirm": "^3.0.5",
    "mqtt": "^5.15.1",
    "notistack": "^3.0.2",
    "prismjs": "^1.29.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-pro-sidebar": "^1.1.0-alpha.1",
    "react-router": "^7.17.0",
    "react-showdown": "^2.3.1",
    "react-simple-code-editor": "^0.13.1",
    "victory": "^37.3.6"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 3000",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "build": "vite build",
    "test": "jest",
    "postbuild": "rm -rf ../core/pioreactor/web/static/* && cp -R build/* ../core/pioreactor/web/static"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true
    },
    "extends": [],
    "plugins": [
      "react",
      "react-hooks",
      "unused-imports"
    ],
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/prop-types": "off",
      "react/jsx-uses-react": "error",
      "react/jsx-uses-vars": "error",
      "react/react-in-jsx-scope": "off",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn",
      "no-unused-vars": "off",
      "unused-imports/no-unused-imports": "warn",
      "unused-imports/no-unused-vars": [
        "warn",
        {
          "vars": "all",
          "varsIgnorePattern": "^_",
          "args": "after-used",
          "argsIgnorePattern": "^(?:_.*|e|err|error)$",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^(?:_.*|e|err|error)$"
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      "> 0.5%",
      "last 2 versions",
      "Firefox ESR",
      "not dead",
      "safari >= 15.4",
      "iOS >= 15.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-jest": "^30.4.1",
    "css-loader": "^5.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "2.1.2",
    "style-loader": "^2.0.0",
    "vite": "^7.3.6"
  }
}
