dataset_name: growth_rates
default_order_by: timestamp
description: This dataset includes a time series of the calculated (implied) growth
  rate. This data matches what's presented in the 'Implied growth rate' chart in the
  Experiment Overview.
display_name: Implied growth rate
has_experiment: true
has_unit: true
source: app
table: growth_rates
timestamp_columns:
- timestamp
column_descriptions:
  experiment: Experiment name.
  pioreactor_unit: Pioreactor unit name.
  timestamp: UTC timestamp for the growth-rate estimate.
  timestamp_localtime: Local-time rendering of timestamp.
  hours_since_experiment_created: Hours from experiment creation to timestamp.
  rate: Calculated implied growth rate emitted by growth_rate_calculating.
column_units:
  hours_since_experiment_created: h
  rate: h^-1
