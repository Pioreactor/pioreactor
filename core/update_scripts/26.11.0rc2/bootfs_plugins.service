[Unit]
Description=Install plugin wheels staged in /boot/firmware/pioreactor/plugins
After=firstboot.service everyboot.service
Wants=everyboot.service

[Service]
EnvironmentFile=/etc/pioreactor.env
ExecStart=/bin/bash /usr/local/bin/bootfs_plugins.sh
Type=oneshot
RemainAfterExit=yes
# Bound the complete boot operation, including plugin hooks and filesystem work.
TimeoutStartSec=1h
