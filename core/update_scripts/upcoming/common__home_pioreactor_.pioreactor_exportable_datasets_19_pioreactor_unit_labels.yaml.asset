dataset_name: pioreactor_unit_labels
default_order_by: created_at
has_experiment: true
has_unit: true
source: app
table: pioreactor_unit_labels
timestamp_columns:
- created_at
display_name: Pioreactor unit labels
description: In this dataset, you'll find the labels assigned to a Pioreactor during an experiment.
column_descriptions:
  experiment: Experiment name.
  pioreactor_unit: Pioreactor unit name.
  label: User-assigned label for the Pioreactor unit within the experiment.
  created_at: UTC timestamp when the label was created or last updated.
  created_at_localtime: Local-time rendering of created_at.
  hours_since_experiment_created: Hours from experiment creation to created_at.
column_units:
  hours_since_experiment_created: h
